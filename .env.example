APP_ENV=local
APP_URL=https://dijirota.com
ORDER_NOTIFICATION_EMAIL=sdkkrtll@gmail.com
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dijirota
DB_USER=dijirota_user
DB_PASSWORD=change-me
ADMIN_SEED_EMAIL=admin@dijirota.com
ADMIN_SEED_PASSWORD=change-me-before-production

# PayTR values are intentionally empty until the merchant account is approved.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1

# İsteğe bağlı OpenAI alternatif sağlayıcı ayarları (NVIDIA kullanıyorsanız boş bırakabilirsiniz).
# Anahtarı tarayıcıya veya kaynak koda yazmayın.
OPENAI_API_KEY=
OPENAI_BLOG_MODEL=gpt-5.6-terra
OPENAI_BLOG_WEB_SEARCH=1
OPENAI_BLOG_VECTOR_STORE_ID=
OPENAI_BLOG_MAX_OUTPUT_TOKENS=12000

# Blog üretim sağlayıcısı: openai veya nvidia.
# NVIDIA Build için anahtarı https://build.nvidia.com adresinden alın.
# NVIDIA Build Chat Completions kullandığı için web araması bu sağlayıcıda otomatik değildir;
# araştırma talimatı alanına güvenilir kaynak URL'leri ekleyebilirsiniz.
BLOG_AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_BLOG_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BLOG_MAX_OUTPUT_TOKENS=5000
# İsteğe bağlı kapak görseli üretimi. Aynı NVIDIA anahtarıyla denenir;
# görsel model hesabınızda açık değilse yazı yine görselsiz kaydedilir.
NVIDIA_IMAGE_API_URL=https://ai.api.nvidia.com/v1/genai/stabilityai/stable-diffusion-3-medium
NVIDIA_IMAGE_MODEL=sd3

# Yeni Blog Atölyesi: kurulurken yerelde üretilen servis bağlantı anahtarı
BLOG_BRIDGE_SECRET=
NVIDIA_TEXT_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_API_KEY ve BLOG_AI_PROVIDER yukarıdaki mevcut alanlardan okunur.
